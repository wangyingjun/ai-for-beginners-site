{
  "name": "ai-for-beginners-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "prepare:jupyterlite": "node scripts/prepare-jupyterlite.mjs",
