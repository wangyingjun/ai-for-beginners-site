{
  "name": "ai-for-beginners-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-search-index.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "prepare:jupyterlite": "node scripts/prepare-jupyterlite.mjs",
    "build:jupyterlite": "node scripts/prepare-jupyterlite.mjs && cd jupyterlite-src && ../.venv-jupyterlite/bin/jupyter lite build --contents content --output-dir ../public/jupyterlite --apps lab --apps notebooks --apps tree --no-sourcemaps",
    "import:quizzes": "node scripts/import-quizzes.mjs",
    "generate:quiz-zh": "python3 scripts/generate-quiz-zh.py",
    "build:rag": "node scripts/build-rag-index.mjs",
    "build:search-index": "node scripts/build-search-index.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.110",
    "@ai-sdk/azure": "^2.0.143",
    "@ai-sdk/openai": "^2.0.136",
    "@assistant-ui/react": "^0.15.30",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^5.0.279",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
